<PageHeader as |p|>
  <p.top>
    <Page::Breadcrumbs @breadcrumbs={{@breadcrumbs}} />
  </p.top>
  <p.levelLeft>
    <h1 class="title is-3" data-test-header-title>
      <Icon @name={{@model.icon}} @size="24" class="has-text-grey-light" />
      {{@model.id}}
    </h1>
  </p.levelLeft>
</PageHeader>

<div class="tabs-container box is-bottomless is-marginless is-paddingless">
  <nav class="tabs" aria-label={{t "kubernetes tabs"}}>
    <ul>
      <LinkTo @route="overview" data-test-tab="overview" @model={{(current-mount-path)}}>{{t "Overview"}}</LinkTo>
      <LinkTo @route="roles" data-test-tab="roles" @model={{(current-mount-path)}}>{{t "Roles"}}</LinkTo>
      <LinkTo @route="configuration" data-test-tab="config" @model={{(current-mount-path)}}>{{t "Configuration"}}</LinkTo>
    </ul>
  </nav>
</div>

<Toolbar>
  {{#if @filterRoles}}
    <ToolbarFilters>
      <NavigateInput @filter={{@rolesFilterValue}} @placeholder={{t "Filter roles"}} @urls={{this.urls}} />
    </ToolbarFilters>
  {{/if}}
  <ToolbarActions>
    {{yield}}
  </ToolbarActions>
</Toolbar>