<div class="message {{@type.class}}">
  <div class="columns is-mobile is-variable is-1">
    <div class="column is-narrow message-icon">
      <Icon aria-hidden="true" @name={{@type.glyph}} />
    </div>
    <div class="column">
      <button type="button" class="close-button" {{on "click" @close}}>
        <Icon @name="x" aria-label={{t "Close"}} />
      </button>
      <div class="message-title">
        {{t @type.text}}
      </div>
      {{#if @message}}
        <p class="message-body {{if @isPreformatted 'pre'}}" data-test-flash-message-body="true">{{t @message}}</p>
      {{/if}}
    </div>
  </div>
</div>