{{#if this.showMessage}}
  {{#if (has-block)}}
    <p class="namespace-reminder">
      {{yield (hash namespace=this.namespace)}}
    </p>
  {{else}}
    <p class="namespace-reminder">
      {{t "This"}}
      {{@noun}}
      {{t "will be"}}
      {{this.modeVerb}}
      {{t "in the"}}
      <span class="tag">{{this.namespace.path}}/</span>{{t "namespace."}}
    </p>
  {{/if}}
{{/if}}