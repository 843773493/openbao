{{#if @label}}
  <label class="is-label" ...attributes>
    {{t @label}}
    {{#if @helpText}}
      <InfoTooltip>
        <span data-test-help-text>{{t @helpText}}</span>
      </InfoTooltip>
    {{/if}}
  </label>
{{/if}}
{{#if @subText}}
  <p class="sub-text" data-test-label-subtext>
    {{t @subText}}
    {{#if @docLink}}
      <DocLink @path={{@docLink}}>
        {{t "See our documentation"}}
      </DocLink>
      {{t "for help."}}
    {{/if}}
  </p>
{{/if}}