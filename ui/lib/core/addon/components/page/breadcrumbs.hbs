<nav class="breadcrumb" aria-label={{t "breadcrumbs"}} data-test-breadcrumbs>
  <ul>
    {{#each @breadcrumbs as |breadcrumb|}}
      <li>
        <span class="sep">/</span>
        {{#if breadcrumb.linkExternal}}
          <LinkToExternal @route={{breadcrumb.route}}>{{t breadcrumb.label}}</LinkToExternal>
        {{else if breadcrumb.route}}
          {{#if breadcrumb.models}}
            <LinkTo @route={{breadcrumb.route}} @models={{breadcrumb.models}}>
              {{t breadcrumb.label}}
            </LinkTo>
          {{else}}
            <LinkTo @route={{breadcrumb.route}} @model={{breadcrumb.model}}>
              {{t breadcrumb.label}}
            </LinkTo>
          {{/if}}
        {{else}}
          {{t breadcrumb.label}}
        {{/if}}
      </li>
    {{/each}}
  </ul>
</nav>