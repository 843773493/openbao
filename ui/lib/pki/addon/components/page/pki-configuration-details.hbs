{{#if @hasConfig}}
  <Toolbar>
    <ToolbarActions>
      {{#if @canDeleteAllIssuers}}
        <button
          type="button"
          class="toolbar-link"
          {{on "click" (fn (mut this.showDeleteAllIssuers) true)}}
          data-test-delete-all-issuers-link
        >
          {{t "Delete all issuers"}}
          <Icon @name="chevron-right" />

        </button>
        <div class="toolbar-separator"></div>
      {{/if}}
      <ToolbarLink @route="configuration.edit" @model={{(current-mount-path)}}>
        {{t "Edit configuration"}}
      </ToolbarLink>
    </ToolbarActions>
  </Toolbar>

  {{#if (not-eq @cluster 403)}}
    <h2 class="title is-4 has-bottom-margin-xs has-top-margin-xl has-border-bottom-light has-bottom-padding-s">
      {{t "Cluster Config"}}
    </h2>
    {{#each @cluster.allFields as |attr|}}
      <InfoTableRow
        @label={{t (or attr.options.label (humanize (dasherize attr.name)))}}
        @value={{or (get @cluster attr.name) "None"}}
      />
    {{/each}}
  {{/if}}

  {{#if (not-eq @acme 403)}}
    <h2 class="title is-4 has-bottom-margin-xs has-top-margin-xl has-border-bottom-light has-bottom-padding-s">
      {{t "ACME Config"}}
    </h2>
    {{#each @acme.allFields as |attr|}}
      <InfoTableRow
        @label={{t (or attr.options.label (humanize (dasherize attr.name)))}}
        @value={{or (get @acme attr.name) "None"}}
      />
    {{/each}}
  {{/if}}

  {{#if (not-eq @urls 403)}}
    <h2 class="title is-4 has-bottom-margin-xs has-top-margin-xl has-border-bottom-light has-bottom-padding-s">
      {{t "Global URLs"}}
    </h2>
    <InfoTableRow @label={{t "Issuing certificates"}} @value={{or @urls.issuingCertificates "None"}} />
    <InfoTableRow
      @label={{t "CRL distribution points"}}
      @value={{if @urls.crlDistributionPoints @urls.crlDistributionPoints "None"}}
    />
  {{/if}}

  {{#if (not-eq @crl 403)}}
    <h2 class="title is-4 has-bottom-margin-xs has-top-margin-xl has-border-bottom-light has-bottom-padding-s">
      {{t "Certificate Revocation List (CRL)"}}
    </h2>
    <InfoTableRow @label={{t "CRL building"}} @value={{if @crl.disable "Disabled" "Enabled"}} />
    {{#unless @crl.disable}}
      <InfoTableRow @label={{t "Expiry"}} @value={{@crl.expiry}} />
      <InfoTableRow @label={{t "Auto-rebuild"}}>
        <Icon
          class={{if @crl.autoRebuild "icon-true" "icon-false"}}
          @name={{if @crl.autoRebuild "check-circle" "x-square"}}
        />
        {{if @crl.autoRebuild "On" "Off"}}
      </InfoTableRow>
      {{#if @crl.autoRebuild}}
        <InfoTableRow @label={{t "Auto-rebuild grace period"}} @value={{@crl.autoRebuildGracePeriod}} />
      {{/if}}
      <InfoTableRow @label={{t "Delta CRL building"}}>
        <Icon
          class={{if @crl.enableDelta "icon-true" "icon-false"}}
          @name={{if @crl.enableDelta "check-circle" "x-square"}}
        />
        {{if @crl.enableDelta "On" "Off"}}
      </InfoTableRow>
      {{#if @crl.enableDelta}}
        <InfoTableRow @label={{t "Delta rebuild interval"}} @value={{@crl.deltaRebuildInterval}} />
      {{/if}}
    {{/unless}}
    <h2 class="title is-4 has-bottom-margin-xs has-top-margin-xl has-border-bottom-light has-bottom-padding-s">
      {{t "Online Certificate Status Protocol (OCSP)"}}
    </h2>
    <InfoTableRow @label={{t "Responder APIs"}} @value={{if @crl.ocspDisable "Disabled" "Enabled"}} />
    {{#unless @crl.ocspDisable}}
      <InfoTableRow @label={{t "Interval"}} @value={{@crl.ocspExpiry}} />
    {{/unless}}

  {{/if}}
{{else}}
  <Toolbar>
    <ToolbarActions>
      <ToolbarLink @route="configuration.create" data-test-configure-pki-button @model={{(current-mount-path)}}>
        {{t "Configure"}}
      </ToolbarLink>
    </ToolbarActions>
  </Toolbar>
{{/if}}

<h2
  class="title is-4 has-bottom-margin-xs has-border-bottom-light has-bottom-padding-s
    {{if (or @hasConfig (and (eq @crl 403) (eq @urls 403))) 'has-top-margin-xl' 'has-top-margin-m'}}"
>
  {{t "Mount Configuration"}}
</h2>
<InfoTableRow @label={{t "Secret engine type"}} @value={{@mountConfig.engineType}} />
<InfoTableRow @label={{t "Path"}} @value={{@mountConfig.path}} />
<InfoTableRow @label={{t "Accessor"}} @value={{@mountConfig.accessor}} />
<InfoTableRow @label={{t "Local"}} @value={{@mountConfig.local}} />
<InfoTableRow @label={{t "Seal wrap"}} @value={{@mountConfig.sealWrap}} />
<InfoTableRow @label={{t "Default lease TTL"}} @value={{@mountConfig.config.defaultLeaseTtl}} />
<InfoTableRow @label={{t "Max lease TTL"}} @value={{@mountConfig.config.maxLeaseTtl}} />
<div class="has-top-margin-l"></div>

{{#if this.showDeleteAllIssuers}}
  <ConfirmationModal
    @title={{t "Delete All Issuers?"}}
    @toConfirmMsg={{t "deleting all issuers and keys."}}
    @buttonText={{t "Confirm"}}
    @confirmText="delete-all"
    @isActive={{this.showDeleteAllIssuers}}
    @onClose={{action (mut this.showDeleteAllIssuers) false}}
    @onConfirm={{this.deleteAllIssuers}}
  >
    <section class="modal-card-custom">
      {{t "This endpoint deletes"}}
      <strong>{{t "all"}}</strong>
      {{t
        "issuers and keys within the mount. It is highly recommended to use the individual delete operations instead. This mount will be unusable until new issuers and keys are provisioned."
      }}
    </section>
  </ConfirmationModal>
{{/if}}