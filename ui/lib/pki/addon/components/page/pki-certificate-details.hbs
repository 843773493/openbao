<Toolbar>
  <ToolbarActions>
    <button type="button" class="toolbar-link" {{on "click" this.downloadCert}} data-test-pki-cert-download-button>
      {{t "Download"}}
      <Chevron @direction="down" @isButton={{true}} />
    </button>
    {{#if @model.canRevoke}}
      <ConfirmAction
        @buttonClasses="toolbar-link"
        @onConfirmAction={{fn (perform this.revoke)}}
        @confirmTitle={{t "Revoke certificate?"}}
        @confirmButtonText={{t "Revoke"}}
        data-test-pki-cert-revoke-button
      >
        {{t "Revoke certificate"}}
      </ConfirmAction>
    {{/if}}
  </ToolbarActions>
</Toolbar>

{{#if @model.privateKey}}
  <div class="has-top-margin-m">
    <Hds::Alert data-test-cert-detail-next-steps @type="inline" @color="highlight" class="has-bottom-margin-s" as |A|>
      <A.Title>{{t "Next steps"}}</A.Title>
      <A.Description>
        {{t "The"}}
        <code>private_key</code>
        {{t "is only available once. Make sure you copy and save it now."}}
      </A.Description>
    </Hds::Alert>
  </div>
{{/if}}

{{#each @model.formFields as |field|}}
  {{#if field.options.masked}}
    <InfoTableRow @label={{t (or field.options.label (capitalize (humanize (dasherize field.name))))}}>
      <MaskedInput @value={{or (get @model field.name) null}} @displayOnly={{true}} @allowCopy={{true}} />
    </InfoTableRow>
  {{else if (eq field.name "serialNumber")}}
    <InfoTableRow @label={{t "Serial number"}}>
      <code class="has-text-black">{{@model.serialNumber}}</code>
    </InfoTableRow>
  {{else}}
    <InfoTableRow
      @label={{t (capitalize (humanize (dasherize field.name)))}}
      {{! formatDate fields can be 0 which will cause them to always render -- pass null instead }}
      @value={{or (get @model field.name) null}}
      @formatDate={{if field.options.formatDate "MMM dd yyyy hh:mm:ss a"}}
      @alwaysRender={{false}}
    />
  {{/if}}
{{/each}}

<ParsedCertificateInfoRows @model={{@model.parsedCertificate}} />

{{#if @onBack}}
  <div class="field is-grouped box is-fullwidth is-bottomless">
    <div class="control">
      <button
        type="button"
        class="button"
        disabled={{this.revoke.isRunning}}
        {{on "click" @onBack}}
        data-test-pki-cert-details-back
      >
        {{t "Back"}}
      </button>
    </div>
  </div>
{{/if}}