<SecretListHeader
  @model={{this.model.engine}}
  @backendCrumb={{hash
    label=this.model.engine.id
    text=this.model.engine.id
    path="vault.cluster.secrets.backend.list-root"
    model=this.model.engine.id
  }}
  @isEngine={{true}}
/>
{{#if this.model.hasConfig}}
  <Page::PkiTidyStatus @autoTidyConfig={{this.model.autoTidyConfig}} @tidyStatus={{this.tidyStatus}} />
{{else}}
  <Toolbar />
  <EmptyState @title={{t "PKI not configured"}} @message={{t this.notConfiguredMessage}}>
    <LinkTo @route="configuration.create" @model={{(current-mount-path)}}>
      {{t "Configure PKI"}}
    </LinkTo>
  </EmptyState>
{{/if}}