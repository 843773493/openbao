<Hds::SideNav::Portal @ariaLabel={{t "Tools Navigation Links"}} data-test-sidebar-nav-panel="Tools" as |Nav|>
  <Nav.BackLink
    @route="vault.cluster"
    @current-when={{false}}
    @icon="arrow-left"
    @text={{t "Back to main navigation"}}
    data-test-sidebar-nav-link="Back to main navigation"
  />

  <Nav.Title data-test-sidebar-nav-heading="Tools">{{t "Tools"}}</Nav.Title>

  {{#each (tools-actions) as |supportedAction|}}
    {{#if (has-permission "tools" routeParams=supportedAction)}}
      <Nav.Link
        @route="vault.cluster.tools.tool"
        @model={{supportedAction}}
        @text={{t (capitalize supportedAction)}}
        data-test-sidebar-nav-link={{capitalize supportedAction}}
      />
    {{/if}}
  {{/each}}
</Hds::SideNav::Portal>