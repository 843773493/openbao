<PageHeader as |p|>
  <p.levelLeft>
    <h1 class="title is-3">
      <LinkTo @route="vault.cluster.access.leases">{{t "Leases"}}</LinkTo>
    </h1>
  </p.levelLeft>
</PageHeader>
{{! template-lint-configure simple-unless "warn" }}
{{#unless (or (eq this.model.httpStatus 400) (eq this.model.httpStatus 404))}}
  {{t this.model.message}}
{{/unless}}

{{#if (eq this.model.httpStatus 400)}}
  <AlertBanner @type="danger" @message={{t "{arg0} is not a valid lease ID" arg0=(this.model.keyId)}} />
{{else if (eq this.model.httpStatus 404)}}
  <EmptyState
    @title={{t "No leases with that ID"}}
    @message={{t
      'Unable to find lease for the ID "{arg0}". Try going back to the lookup and re-entering the ID.'
      arg0=(this.model.keyId)
    }}
  >
    <LinkTo @route="vault.cluster.access.leases" class="link">
      {{t "Back to lookup"}}
    </LinkTo>
  </EmptyState>
{{else if (eq this.model.httpStatus 403)}}
  <EmptyState
    @title={{t "You don't have access to a lease with that ID"}}
    @message={{t "If you think you've reached this page in error, please contact your administrator."}}
  >
    <LinkTo @route="vault.cluster.access.leases" class="link">
      {{t "Back to lookup"}}
    </LinkTo>
  </EmptyState>
{{else}}
  {{#each this.model.errors as |error|}}
    <AlertBanner @type="danger" @message={{t error}} />
  {{/each}}
{{/if}}