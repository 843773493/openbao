<PageHeader as |p|>
  <p.top>
    <nav class="breadcrumb" aria-label={{t "breadcrumb"}}>
      <ul>
        <li>
          <span class="sep">&#x0002f;</span>
          <LinkTo @route="vault.cluster.access.mfa.enforcements.index">
            {{t "Enforcements"}}
          </LinkTo>
        </li>
      </ul>
    </nav>
  </p.top>
  <p.levelLeft>
    <h1 class="title is-3">
      <Icon @name="lock" @size="24" />
      {{this.model.name}}
    </h1>
  </p.levelLeft>
</PageHeader>
<div class="tabs-container box is-sideless is-fullwidth is-paddingless is-marginless">
  <nav class="tabs" aria-label={{t "Enforcement tabs"}}>
    <ul>
      <LinkTo
        @route="vault.cluster.access.mfa.enforcements.enforcement"
        @query={{hash tab="targets"}}
        data-test-tab="targets"
      >
        {{t "Targets"}}
      </LinkTo>
      <LinkTo
        @route="vault.cluster.access.mfa.enforcements.enforcement"
        @query={{hash tab="methods"}}
        data-test-tab="methods"
      >
        {{t "Methods"}}
      </LinkTo>
    </ul>
  </nav>
</div>
<Toolbar>
  <ToolbarActions>
    <button
      class="toolbar-link"
      onclick={{action (mut this.showDeleteConfirmation) true}}
      type="button"
      data-test-enforcement-delete
    >
      {{t "Delete"}}
    </button>
    <div class="toolbar-separator"></div>
    <ToolbarLink
      @route="vault.cluster.access.mfa.enforcements.enforcement.edit"
      @model={{this.model.id}}
      data-test-enforcement-edit
    >
      {{t "Edit enforcement"}}
    </ToolbarLink>
  </ToolbarActions>
</Toolbar>

{{#if (eq this.tab "targets")}}
  {{#if @model.targets}}
    {{#each @model.targets as |target|}}
      <LinkedBlock
        class="list-item-row"
        @disabled={{not target.link}}
        @params={{union (array target.link) target.linkModels}}
        data-test-target={{target.title}}
      >
        <div class="level is-mobile">
          <div class="level-left">
            <div>
              <Icon @name={{target.icon}} />
              <span class="has-text-weight-semibold has-text-black">
                {{t target.title}}
              </span>
              <div class="has-text-grey is-size-8">
                <code>
                  {{target.subTitle}}
                </code>
              </div>
            </div>
          </div>
          {{#if target.link}}
            <div class="level-right is-flex is-paddingless is-marginless">
              <div class="level-item">
                <PopupMenu>
                  <nav class="menu" aria-label={{t "Enforcement target more menu"}}>
                    <ul class="menu-list">
                      <li>
                        <LinkTo @route={{target.link}} @models={{target.linkModels}} data-test-target-link={{target.title}}>
                          {{t "Details"}}
                        </LinkTo>
                      </li>
                    </ul>
                  </nav>
                </PopupMenu>
              </div>
            </div>
          {{/if}}
        </div>
      </LinkedBlock>
    {{/each}}
  {{else}}
    <EmptyState
      @title={{t "No target exists for this enforcement"}}
      @message={{t "A target might have been deleted after the enforcement was created."}}
    />
  {{/if}}
{{else if (eq this.tab "methods")}}
  {{#each this.model.mfa_methods as |method|}}
    <Mfa::MethodListItem @model={{method}} />
  {{/each}}
{{/if}}

<ConfirmationModal
  @title={{t "Delete enforcement?"}}
  @confirmText={{this.model.name}}
  @toConfirmMsg={{t "deleting the transformation."}}
  @buttonText={{t "Delete"}}
  @isActive={{this.showDeleteConfirmation}}
  @onClose={{action (mut this.showDeleteConfirmation) false}}
  @onConfirm={{this.delete}}
>
  <p class="has-bottom-margin-m">
    {{t "Deleting the"}}
    <strong>{{this.model.name}}</strong>
    {{t "enforcement will mean that the MFA method that depends on it will no longer enforce multi-factor authentication."}}
    <br /><br />
    {{t "Deleting this enforcement cannot be undone; it will have to be recreated."}}
  </p>
  <MessageError @model={{this.model}} @errorMessage={{t this.deleteError}} />
</ConfirmationModal>