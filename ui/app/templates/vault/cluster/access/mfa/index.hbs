<PageHeader as |p|>
  <p.levelLeft>
    <h1 class="title is-3">
      {{t "Multi-factor authentication"}}
    </h1>
  </p.levelLeft>
</PageHeader>

<div class="box is-fullwidth is-sideless is-flex-between is-shadowless is-marginless">
  <p>
    {{t "Configure and enforce multi-factor authentication (MFA) for users logging into OpenBao, for any"}}
    <br />
    {{t "authentication method."}}
    {{! TODO Add a link to a tutorial for 'auth-methods/multi-factor-authentication' }}
  </p>
  <button
    type="submit"
    class="button is-primary"
    {{on "click" (transition-to "vault.cluster.access.mfa.methods.create")}}
    data-test-mfa-configure
  >
    {{t "Configure MFA"}}
  </button>
</div>
<div class="box is-fullwidth is-shadowless">
  <p>
    <b>{{t "Step 1:"}}</b>
    {{t "Set up an MFA configuration using one of the methods; TOTP, Okta, Duo or Pingid."}}
  </p>
  <p>
    <b>{{t "Step 2:"}}</b>
    {{t "Set up an enforcement to map the MFA configuration to your chosen auth method(s)."}}
  </p>
</div>

<div class="box is-fullwidth is-shadowless">
  <img src={{img-path "~/mfa-landing.png"}} alt={{t "MFA configure diagram"}} />
</div>