<PageHeader as |p|>
  <p.levelLeft>
    <h1 class="title is-3">
      {{t "Create {arg0} for {arg1}" arg0=(lowercase (humanize this.model.identityType)) arg1=this.model.canonicalId}}
    </h1>
  </p.levelLeft>
</PageHeader>

<Identity::EditForm @model={{this.model}} @onSave={{perform this.navAfterSave}} />