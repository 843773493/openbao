<Toolbar />

{{#if (gt this.model.length 0)}}
  <Oidc::ClientList @model={{this.model}} />
{{else}}
  <EmptyState
    @title={{t "No applications allowed"}}
    @message={{t
      "Access to this provider has been limited, and no applications are allowed to use it. Edit the provider to allow access."
    }}
  >
    <LinkTo @route="vault.cluster.access.oidc.providers.provider.edit" @model={{this.providerName}}>
      {{t "Edit provider"}}
    </LinkTo>
  </EmptyState>
{{/if}}