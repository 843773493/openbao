{{#if this.showHeader}}
  <PageHeader as |p|>
    <p.top>
      <nav class="breadcrumb" aria-label={{t "breadcrumbs"}}>
        <ul>
          <li>
            <span class="sep">&#x0002f;</span>
            <LinkTo @route="vault.cluster.access.oidc.clients">
              {{t "Applications"}}
            </LinkTo>
          </li>
        </ul>
      </nav>
    </p.top>
    <p.levelLeft>
      <h1 class="title is-3" data-test-oidc-client-header>
        {{this.model.name}}
      </h1>
    </p.levelLeft>
  </PageHeader>

  <div class="tabs-container box is-sideless is-fullwidth is-paddingless is-marginless">
    <nav class="tabs" aria-label={{t "tabs"}}>
      <ul>
        <LinkTo
          @route="vault.cluster.access.oidc.clients.client.details"
          @model={{this.model}}
          data-test-oidc-client-details
        >
          {{t "Details"}}
        </LinkTo>
        <LinkTo
          @route="vault.cluster.access.oidc.clients.client.providers"
          @model={{this.model}}
          data-test-oidc-client-providers
        >
          {{t "Available providers"}}
        </LinkTo>
      </ul>
    </nav>
  </div>
{{/if}}

{{outlet}}