<Toolbar data-test-oidc-client-toolbar>
  <ToolbarActions>
    {{#if this.model.canDelete}}
      <ConfirmAction
        data-test-oidc-client-delete
        @buttonClasses="toolbar-link"
        @onConfirmAction={{this.delete}}
        @confirmTitle={{t "Delete application?"}}
        @confirmMessage={{t "This application will be permanently deleted. You will need to re-create it to use it again."}}
        @confirmButtonText={{t "Delete"}}
      >
        {{t "Delete application"}}
      </ConfirmAction>
      <div class="toolbar-separator"></div>
    {{/if}}
    {{#if this.model.canEdit}}
      <ToolbarLink
        @route="vault.cluster.access.oidc.clients.client.edit"
        @model={{this.model.name}}
        data-test-oidc-client-edit
      >
        {{t "Edit application"}}
      </ToolbarLink>
    {{/if}}
  </ToolbarActions>
</Toolbar>

<div class="box is-fullwidth is-sideless is-paddingless is-marginless">
  <InfoTableRow @label={{t "Name"}} @value={{this.model.name}} @alwaysRender={{true}} />
  <InfoTableRow @label={{t "Type"}} @value={{this.model.clientType}} @alwaysRender={{true}} />
  <InfoTableRow @label={{t "Redirect URI"}} @value={{this.model.redirectUris}} @alwaysRender={{true}} />
  <InfoTableRow @label={{t "Assignment"}} @value={{this.model.assignments}} @alwaysRender={{true}} />
  <InfoTableRow @label={{t "Key"}} @alwaysRender={{true}}>
    <LinkTo @route="vault.cluster.access.oidc.keys.key.details" @model={{this.model.key}}>
      {{this.model.key}}
    </LinkTo>
  </InfoTableRow>
  <InfoTableRow @label={{t "Client ID"}} @value={{this.model.clientId}} @addCopyButton={{true}} @alwaysRender={{true}} />
  <InfoTableRow @label={{t "Client Secret"}}>
    <MaskedInput @value={{this.model.clientSecret}} @displayOnly={{true}} @allowCopy={{true}} @alwaysRender={{true}} />
  </InfoTableRow>
  <InfoTableRow @label={{t "ID Token TTL"}} @value={{format-duration this.model.idTokenTtl}} @alwaysRender={{true}} />
  <InfoTableRow
    @label={{t "Access Token TTL"}}
    @value={{format-duration this.model.accessTokenTtl}}
    @alwaysRender={{true}}
  />
</div>