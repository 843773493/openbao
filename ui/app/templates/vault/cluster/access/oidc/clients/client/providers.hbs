<Toolbar />
{{#if (gt this.model.length 0)}}
  <Oidc::ProviderList @model={{this.model}} />
{{else}}
  <EmptyState
    @title={{t "No available providers"}}
    @message={{t
      "Edit an existing provider or create a new one to allow this application access for authentication requests."
    }}
  >
    <LinkTo @route="vault.cluster.access.oidc.providers">
      {{t "View providers"}}
    </LinkTo>
  </EmptyState>
{{/if}}