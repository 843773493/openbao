<PageHeader as |p|>
  <p.top>
    <KeyValueHeader
      @baseKey={{hash id=this.id}}
      @path="vault.cluster.secrets.backend.list"
      @mode="show"
      @showCurrent={{true}}
      @root={{this.backendCrumb}}
    />
  </p.top>
  <p.levelLeft>
    <h1 class="title is-3">
      {{this.id}}
    </h1>
  </p.levelLeft>
</PageHeader>
{{! Tabs }}
<div class="tabs-container box is-bottomless is-marginless is-fullwidth is-paddingless">
  <nav class="tabs">
    <ul>
      <LinkTo
        @route="vault.cluster.secrets.backend.show"
        @models={{array (current-mount-path) this.id}}
        data-test-secret-tab
      >
        {{t "Secret"}}
      </LinkTo>
      <LinkTo @route="vault.cluster.secrets.backend.metadata" @models={{array (current-mount-path) this.id}}>
        {{t "Metadata"}}
      </LinkTo>
    </ul>
  </nav>
</div>

<Toolbar>
  {{! You must have update on metadata, create is not enough. }}
  {{#if this.model.canUpdateMetadata}}
    <ToolbarActions>
      <ToolbarLink @route="vault.cluster.secrets.backend.edit-metadata" @models={{array (current-mount-path) this.id}}>
        {{t "Edit metadata"}}
      </ToolbarLink>
    </ToolbarActions>
  {{/if}}
</Toolbar>

<div class="form-section">
  <label class="title is-5 has-top-padding-m">
    {{t "Custom metadata"}}
  </label>
</div>
<div class="box is-fullwidth is-sideless is-paddingless is-marginless">
  {{#each-in this.model.customMetadata as |key value|}}
    <InfoTableRow @alwaysRender={{false}} @label={{t key}} @value={{value}} />
  {{else}}{{#if this.noReadAccess}}
      <EmptyState
        @title={{t "You do not have access to read secret metadata"}}
        @bottomBorder={{true}}
        @message={{t
          "In order to edit secret metadata access, the UI requires read permissions; otherwise, data may be deleted. Edits can still be made via the API and CLI."
        }}
      />
    {{else}}
      <EmptyState
        @title={{t "No custom metadata"}}
        @bottomBorder={{true}}
        @message={{t "This data is version-agnostic and is usually used to describe the secret being stored."}}
      >
        {{#if this.model.canUpdateMetadata}}
          <LinkTo
            @route="vault.cluster.secrets.backend.edit-metadata"
            @models={{array (current-mount-path) this.id}}
            data-test-add-custom-metadata
          >
            {{t "Add metadata"}}
          </LinkTo>
        {{/if}}
      </EmptyState>
    {{/if}}{{/each-in}}
</div>
{{#unless this.noReadAccess}}
  <div class="form-section">
    <label class="title is-5 has-top-padding-m">
      {{t "Secret Metadata"}}
    </label>
  </div>
  <div class="box is-fullwidth is-sideless is-paddingless is-marginless">
    <InfoTableRow @alwaysRender={{true}} @label={{t "Maximum versions"}} @value={{this.model.maxVersions}} />
    <InfoTableRow @alwaysRender={{true}} @label={{t "Check-and-Set required"}} @value={{this.model.casRequired}} />
    <InfoTableRow
      @alwaysRender={{true}}
      @label={{t "Delete version after"}}
      @value={{if (eq this.model.deleteVersionAfter "0s") "Never delete" this.model.deleteVersionAfter}}
    />
  </div>
{{/unless}}