{{#if this.model.canUpdateMetadata}}
  <PageHeader as |p|>
    <p.levelLeft>
      <h1 class="title is-3">
        {{t "Edit secret metadata"}}
      </h1>
    </p.levelLeft>
  </PageHeader>
  <SecretEditMetadata @model={{this.model}} />
{{else}}
  <EmptyState
    @title={{t "You do not have permissions to edit metadata"}}
    @message={{t "Ask your administrator if you think you should have access."}}
  >
    <LinkTo
      @route="vault.cluster.secrets.backend.metadata"
      @models={{array (current-mount-path) this.model.id}}
      class="link"
    >
      {{t "View Metadata"}}
    </LinkTo>
    <DocLink @path="/api-docs/secret/kv/kv-v2#createupdate-metadata">{{t "More here"}}</DocLink>
  </EmptyState>
{{/if}}