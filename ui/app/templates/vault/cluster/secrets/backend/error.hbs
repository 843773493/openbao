<div class="box is-shadowless">
  <PageHeader as |p|>
    <p.top>
      <nav class="breadcrumb">
        <li>
          {{#if this.model.backend}}
            <LinkTo @route="vault.cluster.secrets.backend.list-root" @model={{this.model.backend}}>
              <span class="sep">&#x0002f;</span>
              {{this.model.backend}}
            </LinkTo>
          {{else}}
            <LinkTo @route="vault.cluster.secrets">
              <span class="sep">&#x0002f;</span>
              {{t "secrets"}}
            </LinkTo>
          {{/if}}
        </li>
      </nav>
    </p.top>
    <p.levelLeft>
      <h1 class="title is-3 has-text-grey">
        {{#if (eq this.model.httpStatus 404)}}
          {{t "404 Not Found"}}
        {{else if (eq this.model.httpStatus 403)}}
          {{t "Not Authorized"}}
        {{else}}
          {{t "Error"}}
        {{/if}}
      </h1>
    </p.levelLeft>
  </PageHeader>
  <div class="box is-sideless has-background-white-bis has-text-grey has-text-centered">
    {{#if (eq this.model.httpStatus 404)}}
      <p data-test-secret-not-found>
        {{t "Unable to find secret at"}}
        <code>{{concat this.model.backend "/" this.model.secret}}</code>{{t ". Try going back to the"}}
        {{#if this.model.backend}}
          <LinkTo @route="vault.cluster.secrets.backend.list-root" @model={{this.model.backend}}>
            {{t "root"}}
          </LinkTo>
        {{else}}
          <LinkTo @route="vault.cluster.secrets">
            {{t "root"}}
          </LinkTo>
        {{/if}}
        {{t "and navigating from there."}}
      </p>
    {{else if (eq this.model.httpStatus 403)}}
      {{#if (eq this.model.policyPath "sys/capabilities-self")}}
        <p>
          {{t "Your auth token does not have access to"}}
          <code>{{this.model.policyPath}}</code>.
        </p>
        <p>
          {{t "Make sure the policy for the path"}}
          <code>{{this.model.policyPath}}</code>
          {{t "includes"}}
          <code>capabilities = ['update']</code>.
        </p>
      {{else}}
        <p>
          {{t "You don't have access to"}}
          <code>
            {{if this.model.secret (concat this.model.backend "/" this.model.secret) (concat this.model.backend "/")}}
          </code>{{t ". If you think you've reached this page in error, please contact your administrator."}}
        </p>
        <p>
          {{#if this.model.secret}}
            <LinkTo @route="vault.cluster.secrets.backend.list-root" @model={{this.model.backend}}>{{t
                "Navigate back to the root"
              }}</LinkTo>.
          {{else}}
            <LinkTo @route="vault.cluster">{{t "Go back home"}}</LinkTo>.
          {{/if}}
        </p>
      {{/if}}
    {{else}}
      {{#if this.model.message}}
        <p>{{t this.model.message}}</p>
      {{/if}}
      {{#each this.model.errors as |error|}}
        <p class="message">
          {{t error}}
        </p>
      {{/each}}
    {{/if}}
  </div>
</div>