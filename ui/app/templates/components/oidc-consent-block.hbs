{{#if this.didCancel}}
  <h3 class="title is-3" data-test-consent-title>
    {{t "Consent Not Given"}}
  </h3>
  <div class="box">
    <p class="has-bottom-margin-l has-top-margin-l">{{t "Login attempt has been terminated."}}</p>
  </div>
{{else}}
  <h3 class="title is-3" data-test-consent-title>
    {{t "Consent"}}
  </h3>
  <form class="box" {{on "submit" this.handleSubmit}} data-test-consent-form>
    <p class="has-bottom-margin-s">
      {{t
        "In order to complete the login process, you must consent to OpenBao sharing your profile, email, address, and phone with the client."
      }}
    </p>
    <p class="has-bottom-margin-s">{{t "Do you want to continue?"}}</p>
    <FormSaveButtons
      @saveButtonText={{t "Yes"}}
      @isSaving={{false}}
      @cancelButtonText={{t "No"}}
      @onCancel={{this.handleCancel}}
      @includeBox={{false}}
    />
  </form>
{{/if}}