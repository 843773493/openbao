<PageHeader as |p|>
  <p.top>
    <nav class="breadcrumb" aria-label={{t "breadcrumbs"}}>
      <ul>
        <li>
          <span class="sep">&#x0002f;</span>
          <LinkTo @route="vault.cluster.secrets.backend.overview" @model={{@backendPath}}>
            {{@backendPath}}
          </LinkTo>
        </li>
      </ul>
    </nav>
  </p.top>
  <p.levelLeft>
    <h1 data-test-title class="title is-3">
      {{@roleName}}
    </h1>
  </p.levelLeft>
</PageHeader>

<div class={{if @roleType "box is-fullwidth is-sideless is-marginless"}}>
  {{! If no role type, that means both static and dynamic requests returned an error }}
  {{#unless @roleType}}
    <EmptyState
      @title={{t this.errorTitle}}
      @subTitle={{t "Error {arg0}" arg0=(@model.errorHttpStatus)}}
      @icon="alert-circle"
      @bottomBorder={{true}}
      @message={{t @model.errorMessage}}
    >
      <nav class="breadcrumb" aria-label={{t "help breadcrumb"}}>
        <ul class="is-grouped-split">
          <li>
            {{! Empty because they can't go "back" anywhere }}
          </li>
          <li>
            <DocLink @path="/docs/secrets/databases" @class="has-text-grey">
              {{t "Need help?"}}
            </DocLink>
          </li>
        </ul>
      </nav>
    </EmptyState>
  {{/unless}}
  {{#if (and (not @model.errorMessage) (eq @roleType "dynamic"))}}
    <AlertBanner
      @type="warning"
      @message={{t "You will not be able to access these credentials later, so please copy them now."}}
      data-test-warning
    />
  {{/if}}
  {{! DYNAMIC ROLE }}
  {{#if (and (eq @roleType "dynamic") @model.username)}}
    <InfoTableRow @label={{t "Username"}} @value={{@model.username}}>
      <MaskedInput @value={{@model.username}} @name="Username" @displayOnly={{true}} @allowCopy={{true}} />
    </InfoTableRow>
    <InfoTableRow @label={{t "Password"}} @value={{@model.password}}>
      <MaskedInput @value={{@model.password}} @name="Password" @displayOnly={{true}} @allowCopy={{true}} />
    </InfoTableRow>
    <InfoTableRow @label={{t "Lease ID"}} @value={{@model.leaseId}} />
    <InfoTableRow @label={{t "Lease Duration"}} @value={{format-duration @model.leaseDuration}} />
  {{/if}}
  {{! STATIC ROLE }}
  {{#if (and (eq @roleType "static") @model.username)}}
    <InfoTableRow
      @label={{t "Last OpenBao rotation"}}
      @value={{date-format @model.lastVaultRotation "MMMM d yyyy, h:mm:ss a"}}
      @tooltipText={{t @model.lastVaultRotation}}
      @isTooltipCopyable={{true}}
    />
    <InfoTableRow @label={{t "Password"}} @value={{@model.password}}>
      <MaskedInput @value={{@model.password}} @name="Password" @displayOnly={{true}} @allowCopy={{true}} />
    </InfoTableRow>
    <InfoTableRow @label={{t "Username"}} @value={{@model.username}} />
    <InfoTableRow @label={{t "Rotation Period"}} @value={{format-duration @model.rotationPeriod}} />
    <InfoTableRow @label={{t "Time Remaining"}} @value={{format-duration @model.ttl}} />
  {{/if}}
</div>
<div class="has-top-bottom-margin">
  <button
    type="button"
    onclick={{action "redirectPreviousPage"}}
    class="button is-primary"
    data-test-secret-generate-back="true"
  >
    {{t "Back"}}
  </button>
</div>