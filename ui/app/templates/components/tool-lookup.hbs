<PageHeader as |p|>
  <p.levelLeft>
    <h1 class="title is-3">
      {{t "Lookup token"}}
    </h1>
  </p.levelLeft>
</PageHeader>

{{#if (or @creation_time @creation_ttl)}}
  <div class="box is-fullwidth is-sideless is-paddingless is-marginless">
    <InfoTableRow @label={{t "Creation path"}} @value={{@creation_path}} data-test-tools="token-lookup-row" />
    <InfoTableRow @label={{t "Creation time"}} @value={{@creation_time}} data-test-tools="token-lookup-row" />
    <InfoTableRow @label={{t "Creation TTL"}} @value={{@creation_ttl}} data-test-tools="token-lookup-row" />
    {{#if @expirationDate}}
      <InfoTableRow @label={{t "Expiration date"}} @value={{@expirationDate}} data-test-tools="token-lookup-row" />
      <InfoTableRow @label={{t "Expires in"}} @value={{date-from-now @expirationDate}} data-test-tools="token-lookup-row" />
    {{/if}}
  </div>
  <div class="field is-grouped box is-fullwidth is-bottomless">
    <div class="control">
      <button {{on "click" this.onClear}} type="button" class="button">
        {{t "Back"}}
      </button>
    </div>
  </div>
{{else}}
  <div class="box is-sideless is-fullwidth is-marginless">
    <NamespaceReminder @mode="perform" @noun={{t @selectedAction}} />
    <MessageError @errors={{@errors}} />
    <div class="field">
      <label for="token" class="is-label">{{t "Wrapped token"}}</label>
      <div class="has-text-grey is-size-8 has-bottom-margin-xs">
        {{t "Enter your wrapped token here to display its information."}}
      </div>
      <div class="control">
        <Input @value={{@token}} class="input" id="token" name="token" data-test-tools-input="wrapping-token" />
      </div>
    </div>
  </div>
  <div class="field is-grouped box is-fullwidth is-bottomless">
    <div class="control">
      <button type="submit" data-test-tools-submit="true" class="button is-primary">
        {{t "Lookup token"}}
      </button>
    </div>
  </div>
{{/if}}