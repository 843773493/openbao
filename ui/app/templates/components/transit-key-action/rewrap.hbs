<form onsubmit={{action @doSubmit (hash ciphertext=@ciphertext context=@context nonce=@nonce key_version=@key_version)}}>
  <div class="box is-sideless is-fullwidth is-marginless">
    <NamespaceReminder @mode="perform" @noun={{t "rewrap"}} />
    <div class="content has-bottom-margin-l">
      <p>
        {{t "You can rewrap the provided ciphertext using the latest version of"}}
        <code>{{@key.name}}</code>
        {{t "as the encryption key."}}
      </p>
    </div>
    <KeyVersionSelect @key={{@key}} @onVersionChange={{action (mut @key_version)}} @key_version={{@key_version}} />
    <div class="field">
      <div class="control is-expanded">
        <JsonEditor @title={{t "Ciphertext"}} @valueUpdated={{action (mut @ciphertext)}} @mode="ruby" />
      </div>
    </div>
    {{#if @key.derived}}
      <div class="field">
        <label for="context" class="is-label">
          {{t "Context"}}
        </label>
        <div class="field has-addons">
          <div class="control">
            <Input @type="text" id="context" @value={{@context}} class="input" data-test-transit-input="context" />
          </div>
          <div class="control">
            <B64Toggle @value={{@context}} @data-test-transit-b64-toggle="context" />
          </div>
        </div>
      </div>
    {{/if}}
    {{#if (eq @key.convergentEncryptionVersion 1)}}
      <div class="field">
        <label for="nonce" class="is-label">{{t "Nonce"}}</label>
        <div class="field has-addons">
          <div class="control">
            <Input @type="text" id="nonce" @value={{@nonce}} class="input" data-test-transit-input="nonce" />
          </div>
          <div class="control">
            <B64Toggle @value={{@nonce}} @data-test-transit-b64-toggle="nonce" />
          </div>
        </div>
      </div>
    {{/if}}
  </div>
  <div class="field box is-fullwidth is-bottomless">
    <div class="content has-bottom-margin-l">
      <p class="help">
        {{t "Submitting this form will update the"}}
        <code>ciphertext</code>
        {{t "in-place."}}
      </p>
    </div>
    <div class="control">
      <button type="submit" class="button is-primary">
        {{t "Rewrap"}}
      </button>
    </div>
  </div>
</form>
<Modal @title={{t "Copy your token"}} @onClose={{action (mut @isModalActive)}} @isActive={{@isModalActive}}>
  <section class="modal-card-body">
    <div class="box is-shadowless is-fullwidth is-sideless">
      <h2 class="title is-6">{{t "Ciphertext"}}</h2>
      <div class="copy-text level">
        <code class="level-left" data-test-encrypted-value="ciphertext">{{@ciphertext}}</code>
        <CopyButton
          class="button is-compact is-transparent level-right"
          data-test-button="modal-copy"
          @text={{t @ciphertext}}
          @buttonType="button"
          @onSuccess={{action (set-flash-message "Ciphertext copied!")}}
        >
          <Icon @name="clipboard-copy" aria-label={{t "Copy"}} />
        </CopyButton>
      </div>
    </div>
  </section>
  <footer class="modal-card-foot">
    <CopyButton
      class="button is-primary copy-close"
      data-test-button="modal-copy-close"
      @text={{t @ciphertext}}
      @buttonType="button"
      @onSuccess={{action @toggleModal "Ciphertext copied!"}}
    >
      {{t "Copy & Close"}}
    </CopyButton>
  </footer>
</Modal>