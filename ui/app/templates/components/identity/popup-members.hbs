<PopupMenu @name="member-edit-menu">
  <nav class="menu">
    <ul class="menu-list">
      <li class="action">
        <ConfirmAction
          @buttonClasses="link is-destroy"
          @confirmButtonText={{t "Remove this group?"}}
          @confirmMessage={{t "This may affect permissions for this group."}}
          @onConfirmAction={{action "performTransaction" this.model this.groupArray this.memberId}}
        >
          {{t "Remove"}}
        </ConfirmAction>
      </li>
    </ul>
  </nav>
</PopupMenu>