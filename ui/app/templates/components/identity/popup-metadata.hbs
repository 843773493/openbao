<PopupMenu @name="metadata-edit-menu">
  <nav class="menu">
    <ul class="menu-list">
      <li class="action">
        <ConfirmAction
          @buttonClasses="link is-destroy"
          @confirmTitle={{t "Remove metadata?"}}
          @confirmMessage={{t "This data may be used outside of OpenBao."}}
          @confirmButtonText={{t "Remove"}}
          @onConfirmAction={{action "performTransaction" this.model this.key}}
        >
          {{t "Remove"}}
        </ConfirmAction>
      </li>
    </ul>
  </nav>
</PopupMenu>