<div class="box is-shadowless is-marginless is-fullwidth">
  {{#if @model.disabled}}
    <AlertBanner
      @type="warning"
      @title={{t "Attention"}}
      @message={{t
        "This {arg0} is disabled. All associated tokens cannot be used, but are not revoked."
        arg0=(@model.identityType)
      }}
      data-test-disabled-warning
    >
      {{#if @model.canEdit}}
        <button onclick={{action "enable" @model}} type="button" class="link" data-test-enable={{true}}>
          {{t "Enable"}}
        </button>
      {{/if}}
    </AlertBanner>
  {{/if}}
  <InfoTableRow @label={{t "Name"}} @value={{@model.name}} data-test-identity-item-name={{true}} />
  <InfoTableRow @label={{t "Type"}} @value={{@model.type}} />
  <InfoTableRow @label={{t "ID"}} @value={{@model.id}} />
  <InfoTableRow @label={{t "Merged Ids"}} @value={{@model.mergedEntityIds}}>
    <div>
      {{#each @model.mergedEntityIds as |id|}}
        <div>
          <code class="has-text-black">{{id}}</code>
        </div>
      {{/each}}
    </div>
  </InfoTableRow>
  <InfoTableRow @label={{t "Created"}} @value={{@model.creationTime}}>
    <time datetime={{@model.creationTime}} title={{t @model.creationTime}}>
      {{date-format @model.creationTime "MMM dd, yyyy h:mm a"}}
    </time>
  </InfoTableRow>
  <InfoTableRow @label={{t "Last Updated"}} @value={{this.model.lastUpdateTime}}>
    <time datetime={{this.model.lastUpdateTime}} title={{t this.model.lastUpdateTime}}>
      {{date-format this.model.lastUpdateTime "MMM dd, yyyy h:mm a"}}
    </time>
  </InfoTableRow>
</div>