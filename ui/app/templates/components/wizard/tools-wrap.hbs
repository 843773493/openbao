{{! template-lint-disable quotes }}
<WizardContent @headerText={{t "Tools"}} @glyph="tour">
  <WizardSection
    @headerText={{t "Wrapping data"}}
    @docText={{t "API: Wrap Data"}}
    @docPath="/api/system/wrapping-wrap.html"
    @instructions={{t 'Enter some data in JSON format and click "Wrap Data".'}}
  >
    <p>
      {{t
        "OpenBao provides several ways to create or wrap data, and manage it from there. Here you can wrap a token (or anything you like) in JSON format. Give it a try."
      }}
    </p>
  </WizardSection>
</WizardContent>