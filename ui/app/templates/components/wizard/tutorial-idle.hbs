<WizardContent @headerText={{t "Welcome to OpenBao"}} @glyph="tour" @class="collapsed" @hidePopup={{true}}>
  <button type="button" class="button is-transparent icon dismiss-collapsed" {{action @onDismiss}}>
    <Icon @name="x" aria-label={{t "Close"}} />
  </button>
  <p>{{t "Want a tour? Our helpful guide will introduce you to the OpenBao Web UI."}}</p>
  <div class="box wizard-divider-box">
    <button type="button" class="button is-transparent has-icon-left has-text-white" {{action @onAdvance}}>
      <Chevron @direction="up" />
      {{t "Let's get started"}}
    </button>
  </div>
</WizardContent>