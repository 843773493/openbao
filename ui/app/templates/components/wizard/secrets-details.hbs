<WizardSection
  @headerText={{t "Your Secrets Engine"}}
  @instructions={{t "Click on the link to add a {arg0} in the page header" arg0=(@nextStep)}}
>
  <p>
    {{#if (eq @mountSubtype "keymgmt")}}
      {{t
        "This secrets engine manages keys and distributes them to external destinations. We recommend that you create a provider to which you can distribute keys."
      }}
    {{else}}
      {{#if @needsEncryption}}
        {{t
          'The Transit Secrets Engine uses encryption keys to provide "encryption as a service". Click on "Create Encryption Key" at the top to create one.'
        }}
      {{/if}}
      {{#if @needsConnection}}
        {{t "Now that the engine has been mounted, let’s connect a"}}
        {{@mountSubtype}}.
      {{/if}}
    {{/if}}
  </p>
</WizardSection>