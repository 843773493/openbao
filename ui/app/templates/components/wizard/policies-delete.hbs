{{! template-lint-disable quotes }}
<WizardContent @headerText={{t "Policies"}} @glyph="tour">
  <WizardSection
    @headerText={{t "Deleting your policy"}}
    @docText={{t "Docs: Policies"}}
    @docPath="/docs/concepts/policies.html"
    @instructions={{t 'Click on "Delete" to remove the policy that you created.'}}
  >
    <p>
      {{#if (eq @currentRouteName "vault.cluster.policies.index")}}
        {{t 'You can delete your test policy by clicking the "..." icon to the right of the policy name.'}}
      {{else}}
        {{t 'You can delete your test policy by clicking "Delete" in the toolbar.'}}
      {{/if}}
    </p>
  </WizardSection>
</WizardContent>