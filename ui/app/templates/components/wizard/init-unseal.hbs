<WizardContent @headerText={{t "Initialization"}} @glyph="tour">
  <WizardSection
    @headerText={{t "Unsealing your vault"}}
    @docText={{t "Learn: Initialization"}}
    @docPath="/intro/getting-started/deploy.html#initializing-the-vault"
  >
    <p>
      {{t "Now we will provide the"}}
      {{pluralize this.componentState.threshold "key"}}
      {{t "that you copied or downloaded to unseal the vault so that we can get started using it. You'll need"}}
      {{pluralize this.componentState.threshold "key"}}
      {{t "total, and"}}
      {{#let (pluralize this.componentState.progress "key" without-count=true) as |word|}}
        {{if
          (eq word "key")
          (concat this.componentState.progress " " word " has ")
          (concat this.componentState.progress " " word " have ")
        }}
      {{/let}}
      {{t "already been provided. Please provide"}}
      {{pluralize (dec this.componentState.progress this.componentState.threshold) "more key"}}
      {{t "to unseal."}}
    </p>
  </WizardSection>
</WizardContent>