{{! template-lint-disable quotes }}
<WizardContent @headerText={{t "Policies"}} @glyph="tour">
  <WizardSection
    @headerText={{t "Your new policy"}}
    @docText={{t "Docs: Policies"}}
    @docPath="/docs/concepts/policies.html"
    @instructions={{t 'Click on "ACL Policies" in the sidebar to go back to the list of policies.'}}
  >
    <p>
      {{t
        "Good job! Here you can see your new policy. If you'd like to edit it, you'd just click \"Edit policy\" in the toolbar."
      }}
    </p>
  </WizardSection>
</WizardContent>