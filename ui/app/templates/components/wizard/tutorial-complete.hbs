<WizardContent @headerText={{t "Thanks for taking the tour!"}} @glyph="tour" @class="collapsed">
  <p>
    {{t "We hope you enjoyed using OpenBao. You can get back to the guide in the user menu in the upper right."}}
  </p>
  <div class="box wizard-divider-box">
    <button type="button" class="button is-transparent has-icon-left has-text-white" {{action this.onDismiss}}>
      <Icon @name="x" />
      {{t "Close"}}
    </button>
  </div>
</WizardContent>