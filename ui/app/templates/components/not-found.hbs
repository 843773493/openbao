<div class="box is-shadowless" data-test-not-found>
  <PageHeader as |p|>
    <p.levelLeft>
      <h1 class="title is-3 has-text-grey">
        {{t "404 Not Found"}}
      </h1>
    </p.levelLeft>
  </PageHeader>
  <div class="box is-sideless has-background-white-bis has-text-grey has-text-centered">
    <p>{{t "Sorry, we were unable to find any content at"}} <code>{{or this.model.path this.path}}</code>.</p>
    <p>
      {{t "Double check the url or"}}
      <ExternalLink @href="/" @sameTab={{true}}>{{t "go back home"}}</ExternalLink>.
    </p>
  </div>
</div>